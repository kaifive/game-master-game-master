{
  "name": "game-master",
  "version": "0.1.0",
  "private": true,
  "description": "Party games for live events: solo mini games, live buzzer games, leaderboards and a big-screen display",
  "repository": {
    "type": "git",
    "url": "https://github.com/kaifive/game-master-game-master"
  },
  "author": "Khai Nguyen",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "emulators": "firebase emulators:start --project demo-game-master",
    "test:rules": "firebase emulators:exec --project demo-game-master --only firestore,database \"vitest run --config vitest.rules.config.mts\"",
    "test:rules:sandbox": "sh scripts/test-rules-sandbox.sh",
    "check:ac": "tsx scripts/check-ac/run.ts",
    "verify:static": "npm run format:check && npm run lint && npm run typecheck && npm run test:coverage && npm run check:ac",
    "verify": "npm run verify:static && npm run test:rules && npm run build",
    "verify:sandbox": "npm run verify:static && npm run test:rules:sandbox && npm run build",
    "prepare": "simple-git-hooks || true"
  },
  "dependencies": {
    "@fontsource/atkinson-hyperlegible": "5.3.0",
    "@fontsource/oswald": "5.3.0",
    "canvas-confetti": "1.9.4",
    "firebase": "13.2.0",
    "firebase-admin": "14.5.0",
    "next": "16.4.5",
    "qrcode-generator": "1.4.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "6.0.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.4",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/canvas-confetti": "1.9.0",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.5",
    "firebase-tools": "15.35.0",
    "jsdom": "30.1.3",
    "lint-staged": "17.6.0",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "simple-git-hooks": "2.14.0",
    "tailwindcss": "4.3.4",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged",
    "pre-push": "npm run typecheck && npm test"
  },
  "lint-staged": {
    "*.{ts,tsx,mts,mjs}": [
      "prettier --write",
      "eslint --fix --max-warnings 0"
    ],
    "*.{json,css,yml,yaml}": "prettier --write"
  },
  "overrides": {
    "jwks-rsa": {
      "jose": "5.10.0"
    }
  }
}
