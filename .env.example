# Copy to .env.local for local development. Never commit real values.
# In Vercel, set these under Settings → Environment Variables
# (Production and Preview). Steps: docs/setup/README.md.

# Firebase web app config (public: these ship to phones)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_DATABASE_URL=

# Server only. Never prefix with NEXT_PUBLIC_.
# The whole service-account JSON file, pasted as one value.
FIREBASE_SERVICE_ACCOUNT=
# The shared admin passphrase for /admin (ADR-005).
ADMIN_PASSPHRASE=
# Added automatically when the Vercel Blob store is connected to the project.
BLOB_READ_WRITE_TOKEN=
